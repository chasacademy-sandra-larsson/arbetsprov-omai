{
  "name": "recept-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ingest": "tsx src/ingest/run.ts",
    "search": "tsx --env-file=.env src/query/cli.ts",
    "dev": "tsx watch --env-file=.env src/api/server.ts",
    "start": "tsx --env-file=.env src/api/server.ts",
    "test": "vitest run",
    "eval": "tsx --env-file=.env src/eval/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@huggingface/transformers": "^3.4.0",
    "chromadb": "^3.0.0",
    "express": "^5.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
